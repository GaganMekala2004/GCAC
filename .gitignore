# Build & Output Directories
bin/
obj/
out/
.vs/
.idea/
tools/

# Database & Storage (Never commit real DBs)
data/*.db
data/*.db-journal
data/*.db-shm
data/*.db-wal

# Repository Workspaces (Never commit cloned target repositories)
workspaces/*
!workspaces/.gitkeep

# Remediation Evidence (Never commit customer remediation details)
evidence/*
!evidence/.gitkeep

# Sensitive Excel Files (Never commit real customer vulnerability workbooks)
*.xlsx
!sample-data/vulnerabilities-synthetic.xlsx

# Credentials, Keys & Secrets
*.env
*.pem
*.key
*.pfx
*.token
appsettings.json
!config/appsettings.example.json

# Temporary & Log files
*.log
dotnet-install.ps1

# Runtime scan outputs & pipeline artifacts (never commit — regenerated by GCAC at runtime)
output/scans/findings.json
output/scans/scan-cache.json
output/scans/scan-history.json
output/scans/nuget-advisories.json
output/*.md

# Remediation pipeline run-state & sandbox instances (runtime-generated)
remediation-output/**/run-state.json
remediation-output/.sandbox-instances/
remediation-output/SCAN-*/
remediation-output/VUL-*/
remediation-output/GCAS-*/

# Local repository registry (machine-specific, runtime-generated)
.gcac/local-repositories.json
